{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/lib/(.*)",
        "destination": "/api/hidden"
      },
      {
        "source": "/tests/(.*)",
        "destination": "/api/hidden"
      },
      {
        "source": "/node_modules/(.*)",
        "destination": "/api/hidden"
      }
    ]
  }
}