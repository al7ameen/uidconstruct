{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/lib/(.*)", "destination": "/api/hidden", "permanent": false },
    { "source": "/tests/(.*)", "destination": "/api/hidden", "permanent": false },
    { "source": "/node_modules/(.*)", "destination": "/api/hidden", "permanent": false }
  ]
}
