# ===== uidconstruct API credentials =====
# These are pre-configured with your custom endpoint.

# OpenAI-compatible API key
OPENAI_API_KEY=sk-YOUR-API-KEY-HERE

# Custom base URL (provider endpoint)
OPENAI_BASE_URL=https://api.b.ai/v1

# Model to use
OPENAI_MODEL=glm-5.3-flash

# Server port
PORT=3000
